{
  "name": "pi-zvec-status",
  "version": "0.3.1",
  "description": "zvec-grep index status and workspace management for Pi.",
  "license": "MIT",
  "author": "shenyankm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenyankm/pi-zvec-status.git"
  },
  "homepage": "https://github.com/shenyankm/pi-zvec-status#readme",
  "bugs": {
    "url": "https://github.com/shenyankm/pi-zvec-status/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "zvec-grep",
    "pi-extension"
  ],
  "files": [
    "index.ts",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run lint && npm run format:check && npm test",
    "lint": "tsc --noEmit",
    "format": "prettier --write index.ts lib test \"*.json\" .github",
    "format:check": "prettier --check index.ts lib test \"*.json\" .github",
    "benchmark": "node --experimental-strip-types test/benchmark.ts",
    "test:menus": "python3 test/environments/real-menu-check.py",
    "test:environments": "node --experimental-strip-types --test test/git.test.ts test/live-status.test.ts test/protocol.test.ts && python3 test/environments/terminal-check.py",
    "coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=85 --test-skip-pattern=\"^Pi loader smoke:\" test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "overrides": {
    "undici@8.10.2": "8.12.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
